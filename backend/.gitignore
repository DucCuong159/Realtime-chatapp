# Backend-specific ignores
# (Common rules like node_modules, .env, logs, OS files
#  are already covered by the root .gitignore)

# Compiled TypeScript output
dist/

# File uploads (if applicable)
uploads/
temp/

# Database dumps & backups
*.dump
*.sql.gz

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions