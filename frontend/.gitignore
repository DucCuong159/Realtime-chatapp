# Frontend-specific ignores
# (Common rules like node_modules, .env, logs, OS files
#  are already covered by the root .gitignore)

# Vite build outputs
dist/
dist-ssr/

# Local overrides
*.local

# Visual Studio project files
*.suo
*.ntvs*
*.njsproj
*.sln

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
